# Local Java API configuration. Copy this file to backend/java/.env.
# Keep the API bound to loopback for direct local development.
PORT=8080
SERVER_ADDRESS=127.0.0.1
DATABASE_URL=jdbc:mysql://localhost:3306/agroclima
DATABASE_USER=agroclima
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=12

# Generate separate random hex strings (at least 32 bytes) for both secrets.
JWT_SECRET=
JWT_TTL_MINUTES=60
INITIAL_ADMIN_EMAIL=admin@agroclima.com
INITIAL_ADMIN_PASSWORD=
INTERNAL_API_KEY=
MAX_LOGIN_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Exact local origins for direct browser-to-API calls; no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:8081,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5500,http://127.0.0.1:8081
