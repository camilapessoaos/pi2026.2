# Optional ThingSpeak source. Leave CHANNEL_ID empty to run the API without it.
THINGSPEAK_CHANNEL_ID=3499301
THINGSPEAK_READ_API_KEY=68TN53H94CEJ8KDU
THINGSPEAK_URL=https://api.thingspeak.com
# Configure as JSON; add/remove metrics according to the channel's field assignments.
THINGSPEAK_FIELD_MAP={"temperature":"field1","humidity":"field2","rainfall":"field3","luminosity":"field4","soilHumidity":"field5"}
THINGSPEAK_POLL_INTERVAL_SECONDS=300
THINGSPEAK_RESULTS_LIMIT=500

# Local Java API and shared internal service key.
JAVA_API_URL=http://localhost:8080
# Must exactly match INTERNAL_API_KEY in backend/java/.env.
INTERNAL_API_KEY=minha_chave_interna_secreta_123

# Explicit local browser origins; no wildcard is used.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:8081,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5500,http://127.0.0.1:8081
REQUEST_TIMEOUT_SECONDS=12
ENABLE_BACKGROUND_SYNC=true
