# ThingSpeak (canal privado). Deixe THINGSPEAK_CHANNEL_ID vazio para rodar a API sem o canal.
THINGSPEAK_CHANNEL_ID=3499301
# Read API Key do canal (ThingSpeak > Channel > API Keys). Preencha somente no seu .env local.
THINGSPEAK_READ_API_KEY=
THINGSPEAK_URL=https://api.thingspeak.com
# Campos ativos do canal: field1 = temperatura (°C), field2 = umidade (%).
# O mapeamento é fixo: qualquer outro valor é rejeitado na inicialização.
THINGSPEAK_FIELD_MAP={"temperature":"field1","humidity":"field2"}
THINGSPEAK_POLL_INTERVAL_SECONDS=300
THINGSPEAK_RESULTS_LIMIT=500

# API Java local e chave interna compartilhada entre Python e Java.
JAVA_API_URL=http://localhost:8080
# Deve ser idêntica a INTERNAL_API_KEY em backend/java/.env e ter pelo menos 32 caracteres.
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=troque_por_uma_chave_aleatoria_com_32_ou_mais_caracteres

# Origens locais explícitas do navegador; nenhum wildcard é usado.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:8081,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5500,http://127.0.0.1:8081
REQUEST_TIMEOUT_SECONDS=12
ENABLE_BACKGROUND_SYNC=true
